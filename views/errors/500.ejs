<%- include('../partials/header') %>

<div class="container py-5 text-center">
  <div class="py-5">
    <div class="display-1 fw-bold text-danger mb-2"><%= statusCode || 500 %></div>
    <h1 class="h2 fw-bold mb-3">Service Temporarily Interrupted</h1>
    <p class="text-muted mb-4 lead" style="max-width: 500px; margin: 0 auto;">
      <%= message || 'An unexpected condition was encountered. Our engineering team has been alerted.' %>
    </p>

    <% if (stack) { %>
      <div class="card bg-light border p-3 text-start small mb-4 mx-auto" style="max-width: 700px; overflow-x: auto;">
        <code><%= stack %></code>
      </div>
    <% } %>

    <div class="d-flex justify-content-center gap-3">
      <a href="/" class="btn btn-luxe-primary px-4 py-2 rounded-pill">
        Return to Homepage
      </a>
      <a href="/contact" class="btn btn-luxe-outline px-4 py-2 rounded-pill">
        Contact Concierge
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
