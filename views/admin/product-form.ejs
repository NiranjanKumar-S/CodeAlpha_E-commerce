<%- include('../partials/adminHeader') %>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
  <div>
    <h1 class="h3 fw-bold mb-1"><%= product ? 'Edit Product: ' + product.product_name : 'Add New Product' %></h1>
    <p class="text-muted small mb-0">Specify product attributes, inventory allocations, and visual media.</p>
  </div>
  <a href="/admin/products" class="btn btn-outline-secondary btn-sm rounded-pill">
    <i class="fa-solid fa-arrow-left me-1"></i> Back to Catalog
  </a>
</div>

<div class="row justify-content-center">
  <div class="col-lg-9">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
      <form action="<%= product ? '/admin/products/edit/' + product.product_id : '/admin/products/add' %>" method="POST" enctype="multipart/form-data">
        <div class="row g-3">
          <!-- Product Name -->
          <div class="col-12">
            <label class="form-label small fw-bold text-muted">Product Title *</label>
            <input type="text" name="product_name" class="form-control rounded-3" value="<%= product ? product.product_name : '' %>" placeholder="e.g. Studio Pro Wireless Headphones" required>
          </div>

          <!-- Category -->
          <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">Category *</label>
            <select name="category_id" class="form-select rounded-3" required>
              <option value="">Select category...</option>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.category_id %>" <%= (product && product.category_id === cat.category_id) ? 'selected' : '' %>>
                    <%= cat.category_name %>
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <!-- Status -->
          <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">Status</label>
            <select name="status" class="form-select rounded-3">
              <option value="active" <%= (!product || product.status === 'active') ? 'selected' : '' %>>Active (Visible in Store)</option>
              <option value="inactive" <%= (product && product.status === 'inactive') ? 'selected' : '' %>>Inactive (Hidden)</option>
            </select>
          </div>

          <!-- Price & Discount Price -->
          <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Regular Price ($) *</label>
            <input type="number" step="0.01" name="price" class="form-control rounded-3" value="<%= product ? product.price : '' %>" placeholder="299.00" required>
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Discount Price ($)</label>
            <input type="number" step="0.01" name="discount_price" class="form-control rounded-3" value="<%= product && product.discount_price ? product.discount_price : '' %>" placeholder="249.00 (optional)">
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Stock Quantity *</label>
            <input type="number" name="stock" class="form-control rounded-3" value="<%= product ? product.stock : '10' %>" min="0" required>
          </div>

          <!-- Image URL or File Upload -->
          <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">Image Web URL</label>
            <input type="url" name="image_url" class="form-control rounded-3" value="<%= product ? product.image : '' %>" placeholder="https://images.unsplash.com/...">
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">Or Upload Image File (Max 5MB)</label>
            <input type="file" name="image_file" class="form-control rounded-3" accept="image/*">
          </div>

          <!-- Flags -->
          <div class="col-12">
            <div class="d-flex gap-4 p-3 bg-light rounded-3 border">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="is_featured" id="chkFeatured" <%= (product && product.is_featured) ? 'checked' : '' %>>
                <label class="form-check-label small fw-semibold" for="chkFeatured">
                  Feature on Homepage
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="is_trending" id="chkTrending" <%= (product && product.is_trending) ? 'checked' : '' %>>
                <label class="form-check-label small fw-semibold" for="chkTrending">
                  Highlight in Trending Collection
                </label>
              </div>
            </div>
          </div>

          <!-- Description -->
          <div class="col-12">
            <label class="form-label small fw-bold text-muted">Product Description & Specs</label>
            <textarea name="description" rows="5" class="form-control rounded-3" placeholder="Describe materials, engineering highlights, battery life, dimensions..."><%= product ? product.description : '' %></textarea>
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
          <a href="/admin/products" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
          <button type="submit" class="btn btn-primary rounded-pill px-4">
            <%= product ? 'Save Product Changes' : 'Create Product' %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
