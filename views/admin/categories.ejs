<%- include('../partials/adminHeader') %>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
  <div>
    <h1 class="h3 fw-bold mb-1">Categories Management</h1>
    <p class="text-muted small mb-0">Organize your store departments, curated lines, and departmental icons.</p>
  </div>
</div>

<div class="row g-4">
  <!-- Add Category Form -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
      <h5 class="fw-bold mb-3">Add New Category</h5>
      <form action="/admin/categories/add" method="POST" enctype="multipart/form-data">
        <div class="mb-3">
          <label class="form-label small fw-bold text-muted">Category Title *</label>
          <input type="text" name="category_name" class="form-control rounded-3" placeholder="e.g. Leather Accessories" required>
        </div>
        <div class="mb-3">
          <label class="form-label small fw-bold text-muted">Image Web URL</label>
          <input type="url" name="image_url" class="form-control rounded-3" placeholder="https://images.unsplash.com/...">
        </div>
        <div class="mb-3">
          <label class="form-label small fw-bold text-muted">Or Upload Image File</label>
          <input type="file" name="image_file" class="form-control rounded-3" accept="image/*">
        </div>
        <div class="mb-4">
          <label class="form-label small fw-bold text-muted">Description</label>
          <textarea name="description" rows="3" class="form-control rounded-3" placeholder="Brief department summary..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
          Create Category
        </button>
      </form>
    </div>
  </div>

  <!-- Categories Table -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="bg-light text-muted small text-uppercase">
            <tr>
              <th class="ps-4 py-3">Category</th>
              <th class="py-3">Slug</th>
              <th class="py-3">Description</th>
              <th class="pe-4 py-3 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(cat => { %>
                <tr>
                  <td class="ps-4 py-3">
                    <div class="d-flex align-items-center gap-3">
                      <img src="<%= cat.image || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=80' %>" alt="" class="rounded-circle border" style="width: 42px; height: 42px; object-fit: cover;">
                      <div class="fw-bold text-dark"><%= cat.category_name %></div>
                    </div>
                  </td>
                  <td class="py-3 text-muted small"><code><%= cat.slug %></code></td>
                  <td class="py-3 text-muted small" style="max-width: 250px;"><%= cat.description || '—' %></td>
                  <td class="pe-4 py-3 text-end">
                    <form action="/admin/categories/delete/<%= cat.category_id %>" method="POST" class="m-0 confirm-delete-form">
                      <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete category">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" class="text-center py-4 text-muted">No categories created yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
