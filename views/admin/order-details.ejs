<%- include('../partials/adminHeader') %>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
  <div>
    <h1 class="h3 fw-bold mb-1">Manage Order: <%= order.order_number %></h1>
    <p class="text-muted small mb-0">Update logistics fulfillment status, mark payments, and inspect client details.</p>
  </div>
  <a href="/admin/orders" class="btn btn-outline-secondary btn-sm rounded-pill">
    <i class="fa-solid fa-arrow-left me-1"></i> Back to Orders
  </a>
</div>

<div class="row g-4 mb-4">
  <!-- Update Status Form -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
      <h5 class="fw-bold mb-3">Update Order Status</h5>
      <form action="/admin/orders/<%= order.order_id %>/status" method="POST">
        <div class="mb-3">
          <label class="form-label small fw-bold text-muted">Fulfillment Status</label>
          <select name="order_status" class="form-select rounded-3">
            <option value="Pending" <%= order.order_status === 'Pending' ? 'selected' : '' %>>Pending</option>
            <option value="Confirmed" <%= order.order_status === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
            <option value="Processing" <%= order.order_status === 'Processing' ? 'selected' : '' %>>Processing</option>
            <option value="Shipped" <%= order.order_status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
            <option value="Delivered" <%= order.order_status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
            <option value="Cancelled" <%= order.order_status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
          </select>
        </div>

        <div class="mb-4">
          <label class="form-label small fw-bold text-muted">Payment Status</label>
          <select name="payment_status" class="form-select rounded-3">
            <option value="pending" <%= order.payment_status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="paid" <%= order.payment_status === 'paid' ? 'selected' : '' %>>Paid</option>
            <option value="failed" <%= order.payment_status === 'failed' ? 'selected' : '' %>>Failed</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
          Save Status Updates
        </button>
      </form>
    </div>

    <!-- Client Shipping Address -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
      <h5 class="fw-bold mb-3">Client Destination</h5>
      <div class="fw-bold text-dark"><%= order.full_name %></div>
      <div class="text-muted small"><%= order.phone %></div>
      <div class="text-muted small"><%= order.customer_email || 'No email registered' %></div>
      <hr class="my-2">
      <div class="text-muted small"><%= order.address_line %></div>
      <div class="text-muted small"><%= order.city %>, <%= order.state %> <%= order.postal_code %></div>
    </div>
  </div>

  <!-- Items and Financials -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
      <div class="p-3 border-bottom">
        <h5 class="fw-bold mb-0">Ordered Items (<%= items.length %>)</h5>
      </div>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="bg-light text-muted small text-uppercase">
            <tr>
              <th class="ps-4 py-3">Product</th>
              <th class="py-3 text-center">Quantity</th>
              <th class="py-3 text-end">Unit Price</th>
              <th class="pe-4 py-3 text-end">Line Total</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr>
                <td class="ps-4 py-3">
                  <div class="d-flex align-items-center gap-3">
                    <img src="<%= item.product_image || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=80' %>" alt="" class="rounded-3 border" style="width: 44px; height: 44px; object-fit: cover;">
                    <div class="fw-bold text-dark small"><%= item.product_name %></div>
                  </div>
                </td>
                <td class="py-3 text-center text-muted small"><%= item.quantity %></td>
                <td class="py-3 text-end text-muted small">$<%= parseFloat(item.price).toFixed(2) %></td>
                <td class="pe-4 py-3 text-end fw-bold text-dark small">$<%= parseFloat(item.subtotal).toFixed(2) %></td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot class="bg-light">
            <tr>
              <td colspan="3" class="text-end fw-semibold text-muted py-2">Subtotal:</td>
              <td class="pe-4 text-end fw-semibold py-2">$<%= parseFloat(order.subtotal).toFixed(2) %></td>
            </tr>
            <tr>
              <td colspan="3" class="text-end fw-semibold text-muted py-2">Shipping Fee:</td>
              <td class="pe-4 text-end fw-semibold py-2">$<%= parseFloat(order.shipping_fee).toFixed(2) %></td>
            </tr>
            <% if (order.discount_amount > 0) { %>
              <tr>
                <td colspan="3" class="text-end fw-semibold text-success py-2">Coupon Discount (<%= order.coupon_code %>):</td>
                <td class="pe-4 text-end fw-semibold text-success py-2">-$<%= parseFloat(order.discount_amount).toFixed(2) %></td>
              </tr>
            <% } %>
            <tr>
              <td colspan="3" class="text-end fw-bold fs-5 py-3">Final Amount:</td>
              <td class="pe-4 text-end fw-bold fs-5 py-3 text-primary">$<%= parseFloat(order.total_amount).toFixed(2) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
