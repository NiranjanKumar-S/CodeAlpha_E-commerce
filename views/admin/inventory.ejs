<%- include('../partials/adminHeader') %>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
  <div>
    <h1 class="h3 fw-bold mb-1">Inventory & Stock Tracking</h1>
    <p class="text-muted small mb-0">Monitor warehouse allocations, adjust quantities in real time, and audit low-stock triggers.</p>
  </div>
</div>

<% if (lowStockProducts && lowStockProducts.length > 0) { %>
  <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex align-items-center gap-2 mb-2">
      <i class="fa-solid fa-triangle-exclamation text-danger fs-5"></i>
      <h5 class="fw-bold mb-0 text-dark">Attention Required: <%= lowStockProducts.length %> Product(s) Below Threshold</h5>
    </div>
    <p class="text-muted small mb-0">The items below have 5 or fewer units available. Restock promptly to prevent customer checkout interruptions.</p>
  </div>
<% } %>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="bg-light text-muted small text-uppercase">
        <tr>
          <th class="ps-4 py-3">Product Name</th>
          <th class="py-3">Category</th>
          <th class="py-3">Current Stock</th>
          <th class="py-3">Status</th>
          <th class="pe-4 py-3 text-end" style="width: 240px;">Adjust Stock</th>
        </tr>
      </thead>
      <tbody>
        <% if (products && products.length > 0) { %>
          <% products.forEach(prod => { %>
            <tr>
              <td class="ps-4 py-3">
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= prod.image || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=80' %>" alt="" class="rounded-3 border" style="width: 44px; height: 44px; object-fit: cover;">
                  <div>
                    <div class="fw-bold text-dark"><%= prod.product_name %></div>
                    <span class="text-muted small">ID: #<%= prod.product_id %></span>
                  </div>
                </div>
              </td>
              <td class="py-3 text-muted small"><%= prod.category_name %></td>
              <td class="py-3">
                <% if (prod.stock <= 5) { %>
                  <span class="badge bg-danger rounded-pill px-3 py-2 fs-7 fw-bold"><%= prod.stock %> units (Low)</span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 fs-7 fw-bold"><%= prod.stock %> units</span>
                <% } %>
              </td>
              <td class="py-3">
                <span class="badge <%= prod.status === 'active' ? 'bg-success' : 'bg-secondary' %> text-capitalize">
                  <%= prod.status %>
                </span>
              </td>
              <td class="pe-4 py-3 text-end">
                <form action="/admin/inventory/update-stock" method="POST" class="d-flex justify-content-end gap-2">
                  <input type="hidden" name="productId" value="<%= prod.product_id %>">
                  <input type="number" name="stock" class="form-control form-control-sm rounded-3 text-center" style="max-width: 90px;" min="0" value="<%= prod.stock %>" required>
                  <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3">Update</button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" class="text-center py-4 text-muted">No inventory records found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
