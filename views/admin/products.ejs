<%- include('../partials/adminHeader') %>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
  <div>
    <h1 class="h3 fw-bold mb-1">Products Catalog</h1>
    <p class="text-muted small mb-0">Manage product details, pricing, inventory stock, and availability status.</p>
  </div>
  <a href="/admin/products/add" class="btn btn-primary rounded-pill">
    <i class="fa-solid fa-plus me-1"></i> Add New Product
  </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="bg-light text-muted small text-uppercase">
        <tr>
          <th class="ps-4 py-3">Product</th>
          <th class="py-3">Category</th>
          <th class="py-3">Price</th>
          <th class="py-3">Discount</th>
          <th class="py-3">Stock</th>
          <th class="py-3">Status</th>
          <th class="pe-4 py-3 text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (products && products.length > 0) { %>
          <% products.forEach(prod => { %>
            <tr>
              <td class="ps-4 py-3">
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= prod.image || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=80' %>" alt="" class="rounded-3 border" style="width: 48px; height: 48px; object-fit: cover;">
                  <div>
                    <div class="fw-bold text-dark"><%= prod.product_name %></div>
                    <span class="text-muted small">ID: #<%= prod.product_id %></span>
                  </div>
                </div>
              </td>
              <td class="py-3 text-muted small"><%= prod.category_name %></td>
              <td class="py-3 fw-semibold text-dark">$<%= parseFloat(prod.price).toFixed(2) %></td>
              <td class="py-3 small text-muted">
                <%= prod.discount_price ? '$' + parseFloat(prod.discount_price).toFixed(2) : '—' %>
              </td>
              <td class="py-3">
                <% if (prod.stock <= 5) { %>
                  <span class="badge bg-danger rounded-pill"><%= prod.stock %> units</span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success rounded-pill"><%= prod.stock %> units</span>
                <% } %>
              </td>
              <td class="py-3">
                <span class="badge <%= prod.status === 'active' ? 'bg-success' : 'bg-secondary' %> text-capitalize">
                  <%= prod.status %>
                </span>
              </td>
              <td class="pe-4 py-3 text-end">
                <div class="d-inline-flex gap-2">
                  <a href="/products/<%= prod.slug %>" target="_blank" class="btn btn-sm btn-outline-secondary rounded-circle" title="View in store">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                  <a href="/admin/products/edit/<%= prod.product_id %>" class="btn btn-sm btn-outline-primary rounded-circle" title="Edit product">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </a>
                  <form action="/admin/products/delete/<%= prod.product_id %>" method="POST" class="m-0 confirm-delete-form">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete product">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="7" class="text-center py-4 text-muted">No products found in the catalog.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
