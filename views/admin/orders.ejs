<%- include('../partials/adminHeader') %>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
  <div>
    <h1 class="h3 fw-bold mb-1">Customer Orders</h1>
    <p class="text-muted small mb-0">Review order payments, fulfillment status, and customer shipping destinations.</p>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="bg-light text-muted small text-uppercase">
        <tr>
          <th class="ps-4 py-3">Order #</th>
          <th class="py-3">Date</th>
          <th class="py-3">Client</th>
          <th class="py-3">Items</th>
          <th class="py-3">Pay Amount</th>
          <th class="py-3">Payment</th>
          <th class="py-3">Order Status</th>
          <th class="pe-4 py-3 text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders && orders.length > 0) { %>
          <% orders.forEach(o => { %>
            <tr>
              <td class="ps-4 py-3 fw-bold text-primary"><%= o.order_number %></td>
              <td class="py-3 text-muted small"><%= new Date(o.created_at).toLocaleDateString() %></td>
              <td class="py-3">
                <div class="fw-semibold text-dark"><%= o.customer_name || 'Guest' %></div>
                <div class="text-muted small" style="font-size: 0.75rem;"><%= o.customer_email || '—' %></div>
              </td>
              <td class="py-3 text-muted small"><%= o.item_count || 1 %> item(s)</td>
              <td class="py-3 fw-bold text-dark">$<%= parseFloat(o.total_amount).toFixed(2) %></td>
              <td class="py-3 small">
                <span class="badge bg-light text-dark border text-uppercase"><%= o.payment_method %></span>
                <span class="badge <%= o.payment_status === 'paid' ? 'bg-success' : 'bg-warning text-dark' %>"><%= o.payment_status %></span>
              </td>
              <td class="py-3">
                <span class="status-pill status-<%= o.order_status.toLowerCase() %>">
                  <%= o.order_status %>
                </span>
              </td>
              <td class="pe-4 py-3 text-end">
                <a href="/admin/orders/<%= o.order_id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                  Inspect & Manage
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="8" class="text-center py-4 text-muted">No orders found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
