<%- include('../partials/adminHeader') %>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
  <div>
    <h1 class="h3 fw-bold mb-1">Executive Dashboard</h1>
    <p class="text-muted small mb-0">Overview of operational metrics, customer throughput, and product stock levels.</p>
  </div>
  <div class="btn-toolbar mb-2 mb-md-0 gap-2">
    <a href="/admin/products/add" class="btn btn-sm btn-primary rounded-pill">
      <i class="fa-solid fa-plus me-1"></i> Add Product
    </a>
  </div>
</div>

<!-- Metric Stat Cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="admin-stat-card border-start border-primary border-4">
      <div class="stat-label">Total Gross Sales</div>
      <div class="stat-val text-primary">$<%= stats.total_sales.toFixed(2) %></div>
      <span class="small text-muted"><i class="fa-solid fa-arrow-trend-up text-success me-1"></i> Lifetime fulfilled</span>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="admin-stat-card border-start border-success border-4">
      <div class="stat-label">Total Customer Orders</div>
      <div class="stat-val text-success"><%= stats.total_orders %></div>
      <span class="small text-muted"><i class="fa-solid fa-cart-shopping me-1"></i> All time purchases</span>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="admin-stat-card border-start border-warning border-4">
      <div class="stat-label">Pending Dispatch</div>
      <div class="stat-val text-warning"><%= stats.pending_orders %></div>
      <span class="small text-muted"><i class="fa-solid fa-clock me-1"></i> Requires courier packaging</span>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="admin-stat-card border-start border-danger border-4">
      <div class="stat-label">Low Stock Alerts</div>
      <div class="stat-val text-danger"><%= stats.low_stock_count %></div>
      <span class="small text-muted"><i class="fa-solid fa-triangle-exclamation text-danger me-1"></i> Under 5 units remaining</span>
    </div>
  </div>
</div>

<!-- Analytics Charts & Quick Actions -->
<div class="row g-4 mb-4">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
      <h5 class="fw-bold mb-3">Revenue & Order Momentum</h5>
      <div style="height: 280px;">
        <canvas id="salesMomentumChart"></canvas>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
      <h5 class="fw-bold mb-3">Category Distribution</h5>
      <div style="height: 250px;">
        <canvas id="categoryPieChart"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- Recent Orders & Low Stock Tables -->
<div class="row g-4">
  <!-- Recent Orders Table -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Recent Customer Orders</h5>
        <a href="/admin/orders" class="small text-decoration-none text-primary fw-semibold">View All Orders &rarr;</a>
      </div>
      <div class="table-responsive">
        <table class="table align-middle mb-0 small">
          <thead class="bg-light text-muted text-uppercase" style="font-size: 0.72rem;">
            <tr>
              <th class="ps-3 py-2">Order #</th>
              <th class="py-2">Client</th>
              <th class="py-2">Amount</th>
              <th class="py-2">Payment</th>
              <th class="py-2">Status</th>
              <th class="pe-3 py-2 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentOrders && recentOrders.length > 0) { %>
              <% recentOrders.forEach(o => { %>
                <tr>
                  <td class="ps-3 py-2 fw-bold text-primary"><%= o.order_number %></td>
                  <td class="py-2"><%= o.customer_name || 'Guest' %></td>
                  <td class="py-2 fw-bold">$<%= parseFloat(o.total_amount).toFixed(2) %></td>
                  <td class="py-2 text-uppercase"><%= o.payment_method %></td>
                  <td class="py-2"><span class="status-pill status-<%= o.order_status.toLowerCase() %>"><%= o.order_status %></span></td>
                  <td class="pe-3 py-2 text-end">
                    <a href="/admin/orders/<%= o.order_id %>" class="btn btn-sm btn-outline-dark rounded-pill py-0 px-2" style="font-size: 0.75rem;">Inspect</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="6" class="text-center py-3 text-muted">No orders placed yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Low Stock Warning Table -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> Critical Stock</h5>
        <a href="/admin/inventory" class="small text-decoration-none text-primary fw-semibold">Inventory &rarr;</a>
      </div>
      <div class="table-responsive">
        <table class="table align-middle mb-0 small">
          <thead class="bg-light text-muted" style="font-size: 0.72rem;">
            <tr>
              <th class="ps-3 py-2">Item</th>
              <th class="py-2 text-end">Stock</th>
            </tr>
          </thead>
          <tbody>
            <% if (lowStockProducts && lowStockProducts.length > 0) { %>
              <% lowStockProducts.forEach(p => { %>
                <tr>
                  <td class="ps-3 py-2">
                    <div class="fw-bold text-truncate" style="max-width: 170px;"><%= p.product_name %></div>
                    <span class="text-muted" style="font-size: 0.7rem;"><%= p.category_name %></span>
                  </td>
                  <td class="pe-3 py-2 text-end">
                    <span class="badge bg-danger rounded-pill"><%= p.stock %> left</span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="2" class="text-center py-3 text-muted">All products have healthy inventory levels.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Sales Momentum Chart
    const ctxSales = document.getElementById('salesMomentumChart');
    if (ctxSales) {
      new Chart(ctxSales, {
        type: 'line',
        data: {
          labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov'],
          datasets: [{
            label: 'Sales Revenue ($)',
            data: [1200, 1900, 3100, 2800, 4200, 4800, <%= stats.total_sales > 5000 ? stats.total_sales : 5420 %>],
            borderColor: '#2563eb',
            backgroundColor: 'rgba(37, 99, 235, 0.1)',
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } }
        }
      });
    }

    // 2. Category Pie Chart
    const ctxCat = document.getElementById('categoryPieChart');
    if (ctxCat) {
      new Chart(ctxCat, {
        type: 'doughnut',
        data: {
          labels: ['Audio', 'Wearables', 'Computing', 'Style', 'Home'],
          datasets: [{
            data: [35, 25, 15, 15, 10],
            backgroundColor: ['#2563eb', '#0f172a', '#d97706', '#10b981', '#8b5cf6']
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false
        }
      });
    }
  });
</script>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
