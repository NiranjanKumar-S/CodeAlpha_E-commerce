<%- include('../partials/header') %>

<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
      <a href="/orders/my-orders" class="text-decoration-none small text-muted mb-1 d-inline-block">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Orders
      </a>
      <h1 class="h3 fw-bold mb-0">Order <%= order.order_number %></h1>
      <span class="text-muted small">Placed on <%= new Date(order.created_at).toLocaleString() %></span>
    </div>
    
    <div class="d-flex gap-2 mt-2 mt-sm-0">
      <button onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="fa-solid fa-print me-1"></i> Print Invoice
      </button>
      <span class="status-pill status-<%= order.order_status.toLowerCase() %> fs-6 px-3 py-1">
        <%= order.order_status %>
      </span>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <h6 class="fw-bold text-uppercase text-muted small mb-3">Client Destination</h6>
        <div class="fw-bold text-dark"><%= order.full_name %></div>
        <div class="text-muted small"><%= order.phone %></div>
        <div class="text-muted small"><%= order.customer_email || '' %></div>
        <div class="text-muted small mt-2"><%= order.address_line %></div>
        <div class="text-muted small"><%= order.city %>, <%= order.state %> <%= order.postal_code %></div>
      </div>
    </div>

    <div class="col-md-6 col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <h6 class="fw-bold text-uppercase text-muted small mb-3">Payment Information</h6>
        <div class="d-flex justify-content-between small text-muted mb-2">
          <span>Method</span>
          <span class="text-uppercase fw-bold text-dark"><%= order.payment_method %></span>
        </div>
        <div class="d-flex justify-content-between small text-muted mb-2">
          <span>Status</span>
          <span class="badge <%= order.payment_status === 'paid' ? 'bg-success' : 'bg-warning text-dark' %>"><%= order.payment_status %></span>
        </div>
        <div class="d-flex justify-content-between small text-muted">
          <span>Voucher Coupon</span>
          <span class="fw-bold text-dark"><%= order.coupon_code || 'None' %></span>
        </div>
      </div>
    </div>

    <div class="col-md-12 col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <h6 class="fw-bold text-uppercase text-muted small mb-3">Order Status Progression</h6>
        <div class="progress mb-2" style="height: 8px;">
          <% 
            let pct = 20;
            if (order.order_status === 'Confirmed') pct = 40;
            if (order.order_status === 'Processing') pct = 60;
            if (order.order_status === 'Shipped') pct = 80;
            if (order.order_status === 'Delivered') pct = 100;
            if (order.order_status === 'Cancelled') pct = 0;
          %>
          <div class="progress-bar bg-primary" role="progressbar" style="width: <%= pct %>%;"></div>
        </div>
        <div class="small text-muted mt-2">
          Current State: <strong class="text-dark"><%= order.order_status %></strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Items Table -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="bg-light text-muted small text-uppercase">
          <tr>
            <th class="ps-4 py-3">Product Description</th>
            <th class="py-3 text-center">Quantity</th>
            <th class="py-3 text-end">Price</th>
            <th class="pe-4 py-3 text-end">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(item => { %>
              <tr>
                <td class="ps-4 py-3">
                  <div class="d-flex align-items-center gap-3">
                    <img src="<%= item.product_image || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=80' %>" alt="" class="rounded-3 border" style="width: 50px; height: 50px; object-fit: cover;">
                    <div>
                      <div class="fw-bold text-dark"><%= item.product_name %></div>
                    </div>
                  </div>
                </td>
                <td class="py-3 text-center text-muted"><%= item.quantity %></td>
                <td class="py-3 text-end text-muted">$<%= parseFloat(item.price).toFixed(2) %></td>
                <td class="pe-4 py-3 text-end fw-bold text-dark">$<%= parseFloat(item.subtotal).toFixed(2) %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
        <tfoot class="bg-light">
          <tr>
            <td colspan="3" class="text-end fw-semibold text-muted py-2">Subtotal:</td>
            <td class="pe-4 text-end fw-semibold py-2">$<%= parseFloat(order.subtotal).toFixed(2) %></td>
          </tr>
          <tr>
            <td colspan="3" class="text-end fw-semibold text-muted py-2">Shipping Fee:</td>
            <td class="pe-4 text-end fw-semibold py-2">$<%= parseFloat(order.shipping_fee).toFixed(2) %></td>
          </tr>
          <% if (order.discount_amount > 0) { %>
            <tr>
              <td colspan="3" class="text-end fw-semibold text-success py-2">Discount:</td>
              <td class="pe-4 text-end fw-semibold text-success py-2">-$<%= parseFloat(order.discount_amount).toFixed(2) %></td>
            </tr>
          <% } %>
          <tr>
            <td colspan="3" class="text-end fw-bold fs-5 py-3">Final Amount:</td>
            <td class="pe-4 text-end fw-bold fs-5 py-3 text-primary">$<%= parseFloat(order.total_amount).toFixed(2) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
