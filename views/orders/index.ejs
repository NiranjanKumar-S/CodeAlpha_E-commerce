<%- include('../partials/header') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h1 class="h3 fw-bold mb-1">My Order History</h1>
      <p class="text-muted small">Track and inspect all historical purchases and shipments.</p>
    </div>
    <a href="/products" class="btn btn-luxe-primary btn-sm rounded-pill">
      Browse Catalog
    </a>
  </div>

  <% if (orders && orders.length > 0) { %>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="bg-light text-muted small text-uppercase">
            <tr>
              <th class="ps-4 py-3">Order #</th>
              <th class="py-3">Date</th>
              <th class="py-3">Items</th>
              <th class="py-3">Total Amount</th>
              <th class="py-3">Payment</th>
              <th class="py-3">Delivery Status</th>
              <th class="pe-4 py-3 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(o => { %>
              <tr>
                <td class="ps-4 py-3 fw-bold text-primary">
                  <%= o.order_number %>
                </td>
                <td class="py-3 text-muted small">
                  <%= new Date(o.created_at).toLocaleDateString() %>
                </td>
                <td class="py-3 small text-muted">
                  <%= o.item_count || 1 %> item(s)
                </td>
                <td class="py-3 fw-bold text-dark">
                  $<%= parseFloat(o.total_amount).toFixed(2) %>
                </td>
                <td class="py-3 small">
                  <span class="badge bg-light text-dark border text-uppercase"><%= o.payment_method %></span>
                  <span class="badge <%= o.payment_status === 'paid' ? 'bg-success' : 'bg-warning text-dark' %>"><%= o.payment_status %></span>
                </td>
                <td class="py-3">
                  <span class="status-pill status-<%= o.order_status.toLowerCase() %>">
                    <%= o.order_status %>
                  </span>
                </td>
                <td class="pe-4 py-3 text-end">
                  <a href="/orders/<%= o.order_id %>" class="btn btn-sm btn-luxe-outline rounded-pill">
                    View Receipt &rarr;
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="empty-state-box my-4">
      <i class="fa-solid fa-receipt empty-icon"></i>
      <h3 class="fw-bold">No Past Orders Found</h3>
      <p class="text-muted">You have not placed any orders yet. Discover our latest collections today.</p>
      <a href="/products" class="btn btn-luxe-primary px-4 py-2 rounded-pill mt-2">
        Explore Products
      </a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
