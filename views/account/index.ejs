<%- include('../partials/header') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h1 class="h3 fw-bold mb-1">My Account Profile</h1>
      <p class="text-muted small">Manage your contact details, security credentials, and view personal activity.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/orders/my-orders" class="btn btn-luxe-outline btn-sm rounded-pill">
        <i class="fa-solid fa-box-open me-1"></i> Orders (<%= orderCount %>)
      </a>
      <a href="/account/wishlist" class="btn btn-luxe-outline btn-sm rounded-pill">
        <i class="fa-regular fa-heart me-1"></i> Wishlist (<%= wishlistCount %>)
      </a>
    </div>
  </div>

  <div class="row g-4">
    <!-- Contact Information Form -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold mb-3">Profile Information</h5>
        <form action="/account/profile" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Full Name</label>
            <input type="text" name="name" class="form-control rounded-3" value="<%= user.name %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Email Address (Immutable)</label>
            <input type="email" class="form-control rounded-3 bg-light" value="<%= user.email %>" readonly disabled>
          </div>
          <div class="mb-4">
            <label class="form-label small fw-bold text-muted">Phone Number</label>
            <input type="tel" name="phone" class="form-control rounded-3" value="<%= user.phone || '' %>" placeholder="+1-555-0123">
          </div>
          <button type="submit" class="btn btn-luxe-primary rounded-pill px-4">
            Save Profile Updates
          </button>
        </form>
      </div>

      <!-- Change Password Form -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h5 class="fw-bold mb-3">Change Password</h5>
        <form action="/account/password" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Current Password</label>
            <input type="password" name="currentPassword" class="form-control rounded-3" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">New Password (Min. 6 chars)</label>
            <input type="password" name="newPassword" class="form-control rounded-3" minlength="6" required>
          </div>
          <div class="mb-4">
            <label class="form-label small fw-bold text-muted">Confirm New Password</label>
            <input type="password" name="confirmPassword" class="form-control rounded-3" minlength="6" required>
          </div>
          <button type="submit" class="btn btn-luxe-outline rounded-pill px-4">
            Update Security Credentials
          </button>
        </form>
      </div>
    </div>

    <!-- Recent Orders Column -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0">Recent Purchases</h5>
          <a href="/orders/my-orders" class="small text-decoration-none text-primary fw-semibold">View All &rarr;</a>
        </div>

        <% if (recentOrders && recentOrders.length > 0) { %>
          <div class="d-flex flex-column gap-3">
            <% recentOrders.forEach(o => { %>
              <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                <div>
                  <div class="fw-bold text-primary small"><%= o.order_number %></div>
                  <div class="text-muted small"><%= new Date(o.created_at).toLocaleDateString() %> • $<%= parseFloat(o.total_amount).toFixed(2) %></div>
                </div>
                <div class="text-end">
                  <span class="status-pill status-<%= o.order_status.toLowerCase() %> mb-1 d-block"><%= o.order_status %></span>
                  <a href="/orders/<%= o.order_id %>" class="small text-decoration-none text-dark fw-semibold">Details &rarr;</a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-0">No past purchases found in your account history.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
