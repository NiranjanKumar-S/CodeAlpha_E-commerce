<%- include('../partials/header') %>

<div class="container py-5">
  <div class="row justify-content-center text-center mb-5">
    <div class="col-lg-7">
      <span class="text-uppercase text-primary fw-bold small" style="letter-spacing: 0.15em;">Direct Concierge</span>
      <h1 class="display-6 fw-bold mt-2 mb-3">Connect With Our Specialists</h1>
      <p class="text-muted">
        Have questions regarding dimensions, shipping schedules, or corporate gifting? Our dedicated client service specialists are here to assist.
      </p>
    </div>
  </div>

  <div class="row g-5 justify-content-center">
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <h4 class="fw-bold mb-4">Send a Message</h4>
        <form action="/contact" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Full Name</label>
            <input type="text" name="name" class="form-control form-control-lg rounded-3" placeholder="e.g. John Doe" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Email Address</label>
            <input type="email" name="email" class="form-control form-control-lg rounded-3" placeholder="john@example.com" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Subject</label>
            <input type="text" name="subject" class="form-control form-control-lg rounded-3" placeholder="Order Inquiry, Product Advice, etc." required>
          </div>
          <div class="mb-4">
            <label class="form-label small fw-bold text-muted">Your Inquiry</label>
            <textarea name="message" rows="4" class="form-control form-control-lg rounded-3" placeholder="How may we assist you?" required></textarea>
          </div>
          <button type="submit" class="btn btn-luxe-primary w-100 py-3 rounded-pill fw-bold">
            <i class="fa-regular fa-paper-plane me-2"></i> Submit Message
          </button>
        </form>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold mb-3">Global Headquarters</h5>
        <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot me-2 text-primary"></i> 450 Madison Avenue, 18th Floor<br>New York, NY 10022</p>
        <p class="text-muted small mb-2"><i class="fa-solid fa-phone me-2 text-primary"></i> +1 (800) 589-3266</p>
        <p class="text-muted small mb-0"><i class="fa-solid fa-envelope me-2 text-primary"></i> concierge@luxecommerce.com</p>
      </div>

      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h5 class="fw-bold mb-3">Concierge Operating Hours</h5>
        <div class="d-flex justify-content-between small text-muted py-1 border-bottom">
          <span>Monday – Friday</span>
          <span class="fw-semibold text-dark">8:00 AM – 9:00 PM EST</span>
        </div>
        <div class="d-flex justify-content-between small text-muted py-1 border-bottom">
          <span>Saturday</span>
          <span class="fw-semibold text-dark">9:00 AM – 6:00 PM EST</span>
        </div>
        <div class="d-flex justify-content-between small text-muted py-1">
          <span>Sunday</span>
          <span class="fw-semibold text-dark">Closed</span>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
