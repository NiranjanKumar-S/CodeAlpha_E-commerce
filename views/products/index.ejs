<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Page Header Breadcrumbs & Title -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1 small">
          <li class="breadcrumb-item"><a href="/" class="text-muted text-decoration-none">Home</a></li>
          <li class="breadcrumb-item active" aria-current="page">
            <%= typeof activeCategory !== 'undefined' && activeCategory ? activeCategory.category_name : 'All Products' %>
          </li>
        </ol>
      </nav>
      <h1 class="h3 fw-bold mb-0">
        <%= typeof activeCategory !== 'undefined' && activeCategory ? activeCategory.category_name : 'All Collections' %>
      </h1>
      <span class="text-muted small">Showing <%= products ? products.length : 0 %> of <%= typeof totalCount !== 'undefined' ? totalCount : (products ? products.length : 0) %> products</span>
    </div>

    <!-- Active Filters Display -->
    <% if (query && (query.search || query.category || query.min_price || query.max_price || query.sort)) { %>
      <div>
        <a href="/products" class="btn btn-outline-secondary btn-sm rounded-pill">
          <i class="fa-solid fa-xmark me-1"></i> Clear Filters
        </a>
      </div>
    <% } %>
  </div>

  <div class="row g-4">
    <!-- Filter Sidebar Column -->
    <div class="col-lg-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 90px; z-index: 10;">
        <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-between">
          <span>Filters</span>
          <i class="fa-solid fa-sliders text-muted fs-6"></i>
        </h5>

        <form action="/products" method="GET">
          <% if (query && query.search) { %>
            <input type="hidden" name="search" value="<%= query.search %>">
          <% } %>

          <!-- Category Selection -->
          <div class="mb-4">
            <label class="form-label small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em;">Category</label>
            <div class="d-flex flex-column gap-2">
              <a href="/products<%= query && query.search ? '?search=' + encodeURIComponent(query.search) : '' %>" class="text-decoration-none small py-1 px-2 rounded-2 <%= !query.category ? 'bg-primary text-white fw-bold' : 'text-dark' %>">
                All Categories
              </a>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <a href="/products?category=<%= cat.slug %><%= query && query.search ? '&search=' + encodeURIComponent(query.search) : '' %>" 
                     class="text-decoration-none small py-1 px-2 rounded-2 <%= (query.category === cat.slug) ? 'bg-primary text-white fw-bold' : 'text-dark' %>">
                    <%= cat.category_name %>
                  </a>
                <% }) %>
              <% } %>
            </div>
          </div>

          <!-- Price Range Filter -->
          <div class="mb-4">
            <label class="form-label small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em;">Price Range ($)</label>
            <div class="row g-2">
              <div class="col-6">
                <input type="number" name="min_price" class="form-control form-control-sm rounded-3" placeholder="Min" value="<%= query.min_price || '' %>">
              </div>
              <div class="col-6">
                <input type="number" name="max_price" class="form-control form-control-sm rounded-3" placeholder="Max" value="<%= query.max_price || '' %>">
              </div>
            </div>
          </div>

          <!-- Sort Ordering -->
          <div class="mb-4">
            <label class="form-label small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em;">Sort By</label>
            <select name="sort" class="form-select form-select-sm rounded-3">
              <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest Arrivals</option>
              <option value="price_asc" <%= query.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="price_desc" <%= query.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="oldest" <%= query.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
            </select>
          </div>

          <button type="submit" class="btn btn-luxe-primary btn-sm w-100 rounded-pill py-2">
            Apply Filters
          </button>
        </form>
      </div>
    </div>

    <!-- Product Grid Column -->
    <div class="col-lg-9">
      <% if (products && products.length > 0) { %>
        <div class="row g-4">
          <% products.forEach(prod => { %>
            <div class="col-6 col-md-4">
              <div class="product-card">
                <div class="product-thumb-wrap">
                  <div class="product-badge-group">
                    <% if (prod.discount_price && prod.discount_price < prod.price) { %>
                      <span class="badge-luxe badge-sale">
                        Save $<%= (prod.price - prod.discount_price).toFixed(0) %>
                      </span>
                    <% } %>
                    <% if (prod.is_featured) { %>
                      <span class="badge-luxe badge-featured">Featured</span>
                    <% } %>
                  </div>

                  <form action="/account/wishlist/toggle/<%= prod.product_id %>" method="POST" class="m-0">
                    <button type="submit" class="wishlist-btn-overlay" title="Add to Wishlist">
                      <i class="fa-regular fa-heart"></i>
                    </button>
                  </form>

                  <a href="/products/<%= prod.slug %>" class="w-100 h-100">
                    <img src="<%= prod.image || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=80' %>" alt="<%= prod.product_name %>" class="product-thumb" loading="lazy">
                  </a>
                </div>

                <div class="product-card-body">
                  <span class="product-category-sub"><%= prod.category_name %></span>
                  <h4 class="product-card-title">
                    <a href="/products/<%= prod.slug %>"><%= prod.product_name %></a>
                  </h4>

                  <div class="product-price-row">
                    <% if (prod.discount_price && prod.discount_price < prod.price) { %>
                      <span class="price-current">$<%= parseFloat(prod.discount_price).toFixed(2) %></span>
                      <span class="price-original">$<%= parseFloat(prod.price).toFixed(2) %></span>
                    <% } else { %>
                      <span class="price-current">$<%= parseFloat(prod.price).toFixed(2) %></span>
                    <% } %>
                  </div>

                  <div class="product-card-actions">
                    <% if (prod.stock > 0) { %>
                      <form action="/cart/add" method="POST" class="w-100">
                        <input type="hidden" name="productId" value="<%= prod.product_id %>">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="btn btn-luxe-primary w-100">
                          <i class="fa-solid fa-bag-shopping"></i> Add to Cart
                        </button>
                      </form>
                    <% } else { %>
                      <button class="btn btn-secondary w-100 disabled" disabled>Out of Stock</button>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <nav aria-label="Page navigation" class="mt-5">
            <ul class="pagination justify-content-center">
              <% if (currentPage > 1) { %>
                <li class="page-item">
                  <a class="page-link rounded-start-pill" href="/products?<%= new URLSearchParams({ ...query, page: currentPage - 1 }).toString() %>">
                    &laquo; Previous
                  </a>
                </li>
              <% } %>
              
              <% for(let p = 1; p <= totalPages; p++) { %>
                <li class="page-item <%= (p === currentPage) ? 'active' : '' %>">
                  <a class="page-link" href="/products?<%= new URLSearchParams({ ...query, page: p }).toString() %>"><%= p %></a>
                </li>
              <% } %>

              <% if (currentPage < totalPages) { %>
                <li class="page-item">
                  <a class="page-link rounded-end-pill" href="/products?<%= new URLSearchParams({ ...query, page: currentPage + 1 }).toString() %>">
                    Next &raquo;
                  </a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>

      <% } else { %>
        <!-- Empty State -->
        <div class="empty-state-box">
          <i class="fa-solid fa-box-open empty-icon"></i>
          <h3 class="fw-bold">No Products Found</h3>
          <p class="text-muted">We couldn't find any items matching your selected filters or search terms.</p>
          <a href="/products" class="btn btn-luxe-primary px-4 rounded-pill mt-2">Reset All Filters</a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
