<% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
    <div class="d-flex align-items-center">
      <i class="fa-solid fa-circle-check me-2 fs-5 text-success"></i>
      <div><%= success_msg %></div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
    <div class="d-flex align-items-center">
      <i class="fa-solid fa-circle-exclamation me-2 fs-5 text-danger"></i>
      <div><%= error_msg %></div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof info_msg !== 'undefined' && info_msg && info_msg.length > 0) { %>
  <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
    <div class="d-flex align-items-center">
      <i class="fa-solid fa-circle-info me-2 fs-5 text-info"></i>
      <div><%= info_msg %></div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
