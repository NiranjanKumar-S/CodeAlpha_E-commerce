<%- include('../partials/header') %>

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
    <h1 class="h3 fw-bold mb-0">Shopping Cart</h1>
    <span class="text-muted small"><%= cart && cart.items ? cart.items.length : 0 %> unique items</span>
  </div>

  <% if (cart && cart.items && cart.items.length > 0) { %>
    <div class="row g-4">
      <!-- Cart Items List Column -->
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead class="bg-light text-muted small text-uppercase">
                <tr>
                  <th class="ps-4 py-3" style="width: 45%;">Product</th>
                  <th class="py-3 text-center">Quantity</th>
                  <th class="py-3 text-end">Price</th>
                  <th class="py-3 text-end">Total</th>
                  <th class="pe-4 py-3 text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% cart.items.forEach(item => { %>
                  <tr>
                    <!-- Product Info -->
                    <td class="ps-4 py-3">
                      <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 overflow-hidden bg-light border flex-shrink-0" style="width: 64px; height: 64px;">
                          <img src="<%= item.image || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=80' %>" alt="<%= item.product_name %>" class="w-100 h-100" style="object-fit: cover;">
                        </div>
                        <div>
                          <h6 class="mb-1 fw-bold">
                            <a href="/products/<%= item.slug %>" class="text-dark text-decoration-none"><%= item.product_name %></a>
                          </h6>
                          <div class="small text-muted">
                            Stock: <span class="<%= item.stock <= 5 ? 'text-danger fw-bold' : 'text-success' %>"><%= item.stock %> units available</span>
                          </div>
                        </div>
                      </div>
                    </td>

                    <!-- Quantity Controls -->
                    <td class="py-3 text-center" style="width: 150px;">
                      <form action="/cart/update" method="POST" class="d-flex justify-content-center">
                        <input type="hidden" name="cartItemId" value="<%= item.cart_item_id %>">
                        <input type="hidden" name="productId" value="<%= item.product_id %>">
                        <div class="input-group input-group-sm" style="max-width: 110px;">
                          <button type="button" class="btn btn-outline-secondary qty-btn-decrease">-</button>
                          <input type="number" name="quantity" class="form-control text-center qty-input" value="<%= item.quantity %>" min="1" max="<%= item.stock %>" onchange="this.form.submit()">
                          <button type="button" class="btn btn-outline-secondary qty-btn-increase">+</button>
                        </div>
                      </form>
                    </td>

                    <!-- Unit Price -->
                    <td class="py-3 text-end fw-semibold text-muted">
                      $<%= parseFloat(item.unitPrice).toFixed(2) %>
                    </td>

                    <!-- Subtotal for line -->
                    <td class="py-3 text-end fw-bold text-dark">
                      $<%= parseFloat(item.itemSubtotal).toFixed(2) %>
                    </td>

                    <!-- Remove Item -->
                    <td class="pe-4 py-3 text-end">
                      <form action="/cart/remove/<%= item.cart_item_id %>" method="POST" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Remove item">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center">
          <a href="/products" class="btn btn-luxe-outline rounded-pill">
            <i class="fa-solid fa-arrow-left me-2"></i> Continue Shopping
          </a>
        </div>
      </div>

      <!-- Order Summary Column -->
      <div class="col-lg-4">
        <!-- Coupon Box -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
          <h5 class="fw-bold mb-3">Promotional Voucher</h5>
          <% if (cart.appliedCoupon) { %>
            <div class="alert alert-success d-flex justify-content-between align-items-center mb-0 py-2 rounded-3">
              <div>
                <strong><%= cart.appliedCoupon.coupon_code %></strong> applied!
                <div class="small">Discount: -<%= cart.appliedCoupon.discount_type === 'percentage' ? cart.appliedCoupon.discount_value + '%' : '$' + cart.appliedCoupon.discount_value %></div>
              </div>
              <form action="/cart/remove-coupon" method="POST" class="m-0">
                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Remove</button>
              </form>
            </div>
          <% } else { %>
            <form action="/cart/apply-coupon" method="POST" class="d-flex gap-2">
              <input type="text" name="couponCode" class="form-control rounded-pill text-uppercase" placeholder="e.g. WELCOME10" required>
              <button type="submit" class="btn btn-dark rounded-pill px-3">Apply</button>
            </form>
            <div class="mt-2 text-muted small">
              Available demo codes: <span class="badge bg-light text-dark border">WELCOME10</span> <span class="badge bg-light text-dark border">SAVE20</span> <span class="badge bg-light text-dark border">FLAT50</span>
            </div>
          <% } %>
        </div>

        <!-- Summary Totals -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
          <h5 class="fw-bold mb-4">Order Summary</h5>
          
          <div class="d-flex justify-content-between text-muted mb-2">
            <span>Bag Subtotal</span>
            <span class="text-dark fw-semibold">$<%= cart.subtotal.toFixed(2) %></span>
          </div>

          <div class="d-flex justify-content-between text-muted mb-2">
            <span>Estimated Shipping</span>
            <% if (cart.shippingFee === 0) { %>
              <span class="text-success fw-bold">FREE</span>
            <% } else { %>
              <span class="text-dark fw-semibold">$<%= cart.shippingFee.toFixed(2) %></span>
            <% } %>
          </div>

          <% if (cart.discountAmount > 0) { %>
            <div class="d-flex justify-content-between text-success mb-2">
              <span>Privilege Discount</span>
              <span>-$<%= cart.discountAmount.toFixed(2) %></span>
            </div>
          <% } %>

          <hr class="my-3">

          <div class="d-flex justify-content-between align-items-baseline mb-4">
            <span class="fw-bold fs-5">Estimated Total</span>
            <span class="display-6 fw-bold text-dark">$<%= cart.totalAmount.toFixed(2) %></span>
          </div>

          <a href="/checkout" class="btn btn-luxe-primary btn-lg w-100 py-3 rounded-pill fw-bold text-center">
            Proceed to Checkout <i class="fa-solid fa-arrow-right ms-2"></i>
          </a>

          <div class="text-center mt-3 text-muted small">
            <i class="fa-solid fa-shield-halved text-success me-1"></i> Bank-grade 256-bit SSL encrypted checkout
          </div>
        </div>
      </div>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="empty-state-box my-5">
      <i class="fa-solid fa-bag-shopping empty-icon"></i>
      <h3 class="fw-bold">Your Shopping Cart is Empty</h3>
      <p class="text-muted">Looks like you haven't added anything to your cart yet.</p>
      <a href="/products" class="btn btn-luxe-primary px-4 py-2 rounded-pill mt-3">
        Discover Collections
      </a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
