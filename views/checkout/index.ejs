<%- include('../partials/header') %>

<div class="container py-4">
  <div class="mb-4 pb-2 border-bottom">
    <h1 class="h3 fw-bold mb-1">Checkout & Dispatch</h1>
    <p class="text-muted small">Please verify your delivery destination and select a preferred payment method.</p>
  </div>

  <form action="/checkout/process" method="POST">
    <div class="row g-4">
      <!-- Left Column: Shipping & Payment -->
      <div class="col-lg-8">
        <!-- 1. Shipping Details -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
          <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
            <span class="badge bg-primary rounded-circle" style="width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center;">1</span>
            Shipping Destination
          </h5>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label small fw-bold text-muted">Full Name *</label>
              <input type="text" name="fullName" class="form-control rounded-3" value="<%= savedAddress ? savedAddress.full_name : (user ? user.name : '') %>" required>
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-bold text-muted">Phone Number *</label>
              <input type="tel" name="phone" class="form-control rounded-3" placeholder="+1-555-0123" value="<%= savedAddress ? savedAddress.phone : (user && user.phone ? user.phone : '') %>" required>
            </div>

            <div class="col-12">
              <label class="form-label small fw-bold text-muted">Email Address (for dispatch tracking) *</label>
              <input type="email" name="email" class="form-control rounded-3" value="<%= user ? user.email : '' %>" required>
            </div>

            <div class="col-12">
              <label class="form-label small fw-bold text-muted">Street Address *</label>
              <input type="text" name="addressLine" class="form-control rounded-3" placeholder="Apartment, suite, unit, building, floor, etc." value="<%= savedAddress ? savedAddress.address_line : '' %>" required>
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-bold text-muted">City *</label>
              <input type="text" name="city" class="form-control rounded-3" value="<%= savedAddress ? savedAddress.city : '' %>" required>
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-bold text-muted">State / Province *</label>
              <input type="text" name="state" class="form-control rounded-3" value="<%= savedAddress ? savedAddress.state : '' %>" required>
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-bold text-muted">Postal Code *</label>
              <input type="text" name="postalCode" class="form-control rounded-3" value="<%= savedAddress ? savedAddress.postal_code : '' %>" required>
            </div>
          </div>
        </div>

        <!-- 2. Payment Method -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
          <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
            <span class="badge bg-primary rounded-circle" style="width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center;">2</span>
            Payment Method
          </h5>

          <!-- COD Option -->
          <div class="form-check p-3 border rounded-3 mb-3 bg-light">
            <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" id="payCOD" value="cod" checked>
            <label class="form-check-label w-100" for="payCOD">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <strong class="d-block text-dark"><i class="fa-solid fa-money-bill-wave text-success me-2"></i> Cash on Delivery (COD)</strong>
                  <span class="text-muted small">Pay with physical currency or mobile payment upon white-glove courier arrival.</span>
                </div>
                <span class="badge bg-success-subtle text-success">Recommended</span>
              </div>
            </label>
          </div>

          <!-- Online Payment Architecture-Ready Option -->
          <div class="form-check p-3 border rounded-3">
            <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" id="payOnline" value="online">
            <label class="form-check-label w-100" for="payOnline">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <strong class="d-block text-dark"><i class="fa-regular fa-credit-card text-primary me-2"></i> Credit / Debit Card & Online Gateway</strong>
                  <span class="text-muted small">Direct secure checkout ready (Stripe/PayPal/Razorpay integration architecture).</span>
                </div>
                <div class="d-flex gap-2">
                  <i class="fa-brands fa-cc-visa text-secondary fs-5"></i>
                  <i class="fa-brands fa-cc-mastercard text-secondary fs-5"></i>
                </div>
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Right Column: Order Review & Confirmation -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 90px;">
          <h5 class="fw-bold mb-3">Order Items (<%= cart.items.length %>)</h5>
          
          <div class="d-flex flex-column gap-3 mb-3 max-h-300 overflow-auto" style="max-height: 240px;">
            <% cart.items.forEach(item => { %>
              <div class="d-flex align-items-center gap-3">
                <div class="rounded-2 overflow-hidden bg-light border flex-shrink-0" style="width: 48px; height: 48px;">
                  <img src="<%= item.image || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=80' %>" alt="<%= item.product_name %>" class="w-100 h-100" style="object-fit: cover;">
                </div>
                <div class="flex-grow-1 overflow-hidden">
                  <div class="text-truncate fw-semibold small"><%= item.product_name %></div>
                  <div class="text-muted small">Qty: <%= item.quantity %> &times; $<%= parseFloat(item.unitPrice).toFixed(2) %></div>
                </div>
                <div class="fw-bold text-dark small">
                  $<%= parseFloat(item.itemSubtotal).toFixed(2) %>
                </div>
              </div>
            <% }) %>
          </div>

          <hr class="my-3">

          <div class="d-flex justify-content-between text-muted small mb-2">
            <span>Subtotal</span>
            <span class="text-dark fw-semibold">$<%= cart.subtotal.toFixed(2) %></span>
          </div>

          <div class="d-flex justify-content-between text-muted small mb-2">
            <span>Shipping</span>
            <% if (cart.shippingFee === 0) { %>
              <span class="text-success fw-bold">FREE</span>
            <% } else { %>
              <span class="text-dark fw-semibold">$<%= cart.shippingFee.toFixed(2) %></span>
            <% } %>
          </div>

          <% if (cart.discountAmount > 0) { %>
            <div class="d-flex justify-content-between text-success small mb-2">
              <span>Coupon (<%= cart.appliedCoupon.coupon_code %>)</span>
              <span>-$<%= cart.discountAmount.toFixed(2) %></span>
            </div>
          <% } %>

          <hr class="my-3">

          <div class="d-flex justify-content-between align-items-baseline mb-4">
            <span class="fw-bold">Total Payable</span>
            <span class="display-6 fw-bold text-dark fs-3">$<%= cart.totalAmount.toFixed(2) %></span>
          </div>

          <button type="submit" class="btn btn-luxe-primary btn-lg w-100 py-3 rounded-pill fw-bold">
            <i class="fa-solid fa-lock me-2"></i> Confirm & Place Order
          </button>

          <p class="text-center text-muted small mt-3 mb-0" style="font-size: 0.75rem;">
            By placing your order, you agree to LUXE's Terms and Conditions.
          </p>
        </div>
      </div>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
